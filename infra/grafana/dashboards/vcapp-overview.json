{
  "title": "vcapp — overview",
  "uid": "vcapp-overview",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["vcapp", "clinical"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "HTTP requests /s",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "sum by (path) (rate(vcapp_requests_total[5m]))", "refId": "A"}]
    },
    {
      "id": 2, "type": "timeseries", "title": "RabbitMQ queue depth",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "rabbitmq_queue_messages_ready", "refId": "A"}]
    },
    {
      "id": 3, "type": "timeseries", "title": "Postgres active connections",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "pg_stat_activity_count", "refId": "A"}]
    },
    {
      "id": 4, "type": "timeseries", "title": "Redis ops/s",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"expr": "rate(redis_commands_processed_total[5m])", "refId": "A"}]
    },
    {
      "id": 5, "type": "logs", "title": "Backend logs",
      "datasource": {"type": "loki"},
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 16},
      "targets": [{"expr": "{compose_service=\"backend\"}", "refId": "A"}]
    }
  ]
}
