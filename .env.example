# ─── App ──────────────────────────────────────────────────────────────────
APP_ENV=dev
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=change-me-32-bytes-minimum-for-production-use-only

# ─── PostgreSQL ───────────────────────────────────────────────────────────
POSTGRES_USER=vcapp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vcapp
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Redis ────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me
REDIS_HOST=redis
REDIS_PORT=6379

# ─── RabbitMQ ─────────────────────────────────────────────────────────────
RABBITMQ_USER=vcapp
RABBITMQ_PASSWORD=change-me
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# ─── MinIO (S3) ───────────────────────────────────────────────────────────
MINIO_ROOT_USER=vcapp
MINIO_ROOT_PASSWORD=change-me-min-8-chars
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_BUCKET_RECORDINGS=recordings
MINIO_BUCKET_SYNTHESES=syntheses

# ─── KMS mock (dev only — Vault en prod) ──────────────────────────────────
KMS_MODE=mock
KMS_MOCK_KEY=ZGV2LWtleS0zMi1ieXRlcy1tdXN0LWJlLWxvbmctZW5vdWdoLW9rPT0=

# ─── Storage encryption (sse-c | none) ────────────────────────────────────
# SSE-C requires HTTPS to MinIO. In dev keep "none"; in prod set "sse-c"
# AND terminate TLS in front of MinIO (or run MinIO with certs).
STORAGE_ENCRYPTION=none
MINIO_SECURE=false

# ─── Auth mode (mock | keycloak) ──────────────────────────────────────────
AUTH_MODE=mock
OIDC_ISSUER=
OIDC_AUDIENCE=vcapp-frontend
OIDC_JWKS_URL=
# When AUTH_MODE=keycloak (compose with docker-compose.keycloak.yml):
#   OIDC_ISSUER=http://keycloak:8080/realms/vcapp
#   OIDC_JWKS_URL=http://keycloak:8080/realms/vcapp/protocol/openid-connect/certs

# ─── Vault (KMS_MODE=vault) ───────────────────────────────────────────────
VAULT_ADDR=
VAULT_TOKEN=
VAULT_TRANSIT_KEY=vcapp-master
# When KMS_MODE=vault (compose with docker-compose.vault.yml):
#   VAULT_ADDR=http://vault:8200
#   VAULT_TOKEN=vcapp-dev-root

# ─── Keycloak / Grafana admin creds (dev only) ────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
VAULT_DEV_ROOT_TOKEN=vcapp-dev-root

# ─── CORS / security ──────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://localhost
