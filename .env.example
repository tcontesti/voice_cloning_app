# ─── App ──────────────────────────────────────────────────────────────────
APP_ENV=dev
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=change-me-32-bytes-minimum-for-production-use-only

# ─── PostgreSQL ───────────────────────────────────────────────────────────
POSTGRES_USER=vcapp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vcapp
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Redis ────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me
REDIS_HOST=redis
REDIS_PORT=6379

# ─── RabbitMQ ─────────────────────────────────────────────────────────────
RABBITMQ_USER=vcapp
RABBITMQ_PASSWORD=change-me
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# ─── MinIO (S3) ───────────────────────────────────────────────────────────
MINIO_ROOT_USER=vcapp
MINIO_ROOT_PASSWORD=change-me-min-8-chars
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_BUCKET_RECORDINGS=recordings
MINIO_BUCKET_SYNTHESES=syntheses

# ─── KMS mock (dev only — Vault en prod) ──────────────────────────────────
KMS_MODE=mock
KMS_MOCK_KEY=change-me-base64-32-bytes=

# ─── CORS / security ──────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://localhost
