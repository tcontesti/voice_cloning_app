# systemd --user unit. Install with:
#   mkdir -p ~/.config/systemd/user
#   cp worker/systemd/worker_chatterbox.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now worker_chatterbox
#
# View logs: journalctl --user -u worker_chatterbox -f
[Unit]
Description=vcapp Celery worker — Chatterbox
After=network.target

[Service]
Type=exec
WorkingDirectory=%h/voice_cloning_app
Environment=VC_APP_ROOT=%h/voice_cloning_app
Environment=VC_VENV=%h/voice_cloning_env/.venv
Environment=VC_SCRIPTS_DIR=%h/voice_cloning/scripts
ExecStart=/usr/bin/env bash %h/voice_cloning_app/worker/start_worker.sh chatterbox
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=default.target
