# API base used by Vite proxy (frontend → backend)
# Dev local on Windows hitting Spark via VPN/SSH tunnel:
#   VITE_API_BASE=http://192.168.x.y:8000
# Dev all-on-one-host:
VITE_API_BASE=http://localhost:8000

# In dev the client always calls /api/* and Vite proxies it.
# Override only if you serve frontend behind a different gateway:
# VITE_API_PREFIX=/api
